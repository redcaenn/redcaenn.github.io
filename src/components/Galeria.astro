---
// Fotos de un evento o acuerdo.
// Se publican solo versiones reducidas (miniatura y una grande de 1600 px); el original nunca se sube,
// para que el sitio no crezca con cada foto de 4 MB.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Foto } from '../lib/datos';
import { marcar } from '../lib/formato';
interface Props { fotos: Foto[] }
const { fotos } = Astro.props;
const archivos = import.meta.glob<{ default: ImageMetadata }>('/fotos/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const lista = await Promise.all(
  fotos
    .map((f) => ({ ...f, img: archivos[`/fotos/${f.archivo}`]?.default }))
    .filter((f) => f.img)
    .map(async (f) => ({ ...f, grande: await getImage({ src: f.img!, width: Math.min(1600, f.img!.width), format: 'webp' }) })),
);
---
{lista.length > 0 && (
  <ul class="galeria">
    {lista.map((f) => (
      <li>
        <figure>
          <a href={f.grande.src} data-visor aria-label={`Ver en grande: ${f.descripcion.replace(/\[EJEMPLO\]\s*/g, '')}`}>
            <Image src={f.img!} alt={f.descripcion} widths={[400, 800]} sizes="(min-width: 60rem) 22rem, 100vw" />
          </a>
          <figcaption set:html={`<span class="pie-descripcion">${marcar(f.descripcion)}</span>` + (f.credito ? `<span class="pie-credito">Foto: ${marcar(f.credito)}</span>` : '')} />
        </figure>
      </li>
    ))}
  </ul>
)}

<!-- Visor: la foto se abre en grande sobre la página; un clic en cualquier parte (o Esc) la cierra.
     Sin JavaScript, el enlace abre la foto grande como página aparte. -->
<dialog class="visor" aria-label="Foto en grande">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <p class="visor-ayuda" aria-hidden="true">Clic en cualquier parte para cerrar</p>
</dialog>

<script>
  const visor = document.querySelector<HTMLDialogElement>('dialog.visor');
  if (visor && typeof visor.showModal === 'function') {
    const img = visor.querySelector('img')!;
    const pie = visor.querySelector('figcaption')!;
    let origen: HTMLElement | null = null;

    document.querySelectorAll<HTMLAnchorElement>('a[data-visor]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return; // abrir en pestaña nueva sigue funcionando
        e.preventDefault();
        const mini = a.querySelector('img');
        img.src = a.href;
        img.alt = mini?.alt ?? '';
        pie.innerHTML = a.closest('figure')?.querySelector('figcaption')?.innerHTML ?? '';
        origen = a;
        document.documentElement.classList.add('visor-abierto');
        visor.showModal();
      });
    });

    // Cerrar: un clic en cualquier parte o Esc. La limpieza no depende del evento 'close',
    // que algunos navegadores no disparan de forma confiable.
    const cerrar = () => {
      if (visor.open) visor.close();
      if (!document.documentElement.classList.contains('visor-abierto')) return;
      document.documentElement.classList.remove('visor-abierto');
      img.removeAttribute('src');
      origen?.focus();
    };
    visor.addEventListener('click', cerrar);
    visor.addEventListener('cancel', (e) => { e.preventDefault(); cerrar(); }); // Esc
    visor.addEventListener('close', cerrar);
  }
</script>
